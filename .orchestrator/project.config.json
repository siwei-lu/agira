{
  "scan": {
    "stack": "rust",
    "package_manager": "cargo",
    "language_marker": "Cargo.toml",
    "edition": "2024",
    "build_command": "cargo build",
    "test_command": "cargo test",
    "lint_command": "cargo clippy -- -D warnings",
    "format_command": "cargo fmt",
    "commit_pattern": "unknown",
    "commit_regex": null,
    "ci_cd": null,
    "monorepo": false,
    "existing_claude_config": false,
    "existing_hooks": false,
    "prd_path": "docs/prd.md",
    "prd_format": "standard",
    "project_type": "cli_tool"
  },
  "state_machine": {
    "states": ["pending", "enriching", "architecting", "in_progress", "verifying", "done", "failed"],
    "transitions": [
      { "from": "pending", "to": "enriching", "condition": "task becomes active (dependencies met)" },
      { "from": "enriching", "to": "architecting", "condition": "awaiting_confirmation === false AND (needs_checkpoint === false OR checkpoint.status !== 'pending')" },
      { "from": "architecting", "to": "in_progress", "condition": "architecture object written AND all decisions resolved (no source: 'unresolved')" },
      { "from": "in_progress", "to": "verifying", "condition": "implementer reports work complete" },
      { "from": "verifying", "to": "done", "condition": "code review passes AND all verification checks pass (fmt + clippy + test) — planner commits then marks done" },
      { "from": "verifying", "to": "in_progress", "condition": "code review failed OR verification failed — retry with failure context" },
      { "from": "any", "to": "failed", "condition": "retry_count >= max_retries" }
    ]
  },
  "models": {
    "planner": "opus",
    "enricher": "sonnet",
    "architect": "sonnet",
    "implementer": "sonnet",
    "implementer_escalation": "opus",
    "implementer_escalation_after_failures": 2,
    "code_reviewer": "sonnet",
    "qa_verifier": "haiku",
    "housekeeper": "opus"
  },
  "verification": {
    "commands": [
      "cargo fmt -- --check",
      "cargo clippy -- -D warnings",
      "cargo test"
    ]
  },
  "commit_regex": "^(feat|fix|chore|docs|refactor|test|perf|ci|build|revert)(\\([a-z0-9-]+\\))?!?: .+",
  "commit_pattern_description": "Conventional Commits: feat(scope): message OR fix: message OR chore: message",
  "branch_strategy": "main",
  "branch_naming_pattern": "main",
  "max_retries": 3,
  "max_housekeeper_cycles": 3,
  "housekeeper": true,
  "sub_agent_roles": ["enricher", "architect", "implementer", "code_reviewer", "qa_verifier", "housekeeper"],
  "reviewer_count": 1,
  "review_score_threshold": 15,
  "scoring_weights": {
    "security_medium": 5,
    "security_low": 2,
    "data_integrity_medium": 5,
    "data_integrity_low": 2,
    "requirements_medium": 4,
    "requirements_low": 1,
    "test_coverage_medium": 4,
    "test_coverage_low": 1,
    "error_handling_medium": 4,
    "error_handling_low": 1,
    "convention_violations_medium": 3,
    "convention_violations_low": 1,
    "code_quality_medium": 3,
    "code_quality_low": 1,
    "edge_cases_medium": 3,
    "edge_cases_low": 1,
    "performance_medium": 3,
    "performance_low": 1,
    "maintainability_medium": 2,
    "maintainability_low": 0.5,
    "style_preferences_low": 0.5,
    "nice_to_haves_low": 0.5
  },
  "custom_review_rules": [
    {
      "item": "Atomic file writes (write to .tmp, then rename) required for any persistent JSON writes",
      "severity": "CRITICAL",
      "category": "data_integrity"
    },
    {
      "item": "All error output must go to stderr; all prompts and structured output to stdout",
      "severity": "HIGH",
      "category": "requirements"
    },
    {
      "item": "Exit codes: 0=success, 1=user error, 2=internal/IO error — must be enforced correctly",
      "severity": "HIGH",
      "category": "requirements"
    }
  ],
  "prd_path": "docs/prd.md",
  "prd_format": "standard",
  "acceptance_testing": {
    "strategy": "cli",
    "evidence": ["terminal_output"],
    "binary": "cargo run --"
  }
}
